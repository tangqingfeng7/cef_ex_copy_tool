#include <windows.h>
#include "build_info.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CEF_CX_VERSION_NUM
 PRODUCTVERSION CEF_CX_VERSION_NUM
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "CEF clipboard hook\0"
            VALUE "FileVersion", CEF_CX_VERSION_STRING "\0"
            VALUE "ProductName", "cef_ex_copy_tool\0"
            VALUE "ProductVersion", CEF_CX_VERSION_STRING "\0"
            VALUE "OriginalFilename", "winmm.dll\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
